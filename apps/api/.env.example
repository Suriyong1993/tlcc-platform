# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/tlcc_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# AI (OpenRouter)
OPENROUTER_API_KEY=

# File Storage (S3-compatible)
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-southeast-1

# App
APP_PORT=3001
NODE_ENV=development
